# ─── Model selection ─────────────────────────────────────────────────────────
# Override the model set in config/default.yaml without editing the file.
# Uses LiteLLM provider prefixes: lm_studio/, ollama/, openai/, anthropic/, etc.
# Example values:
#   lm_studio/qwen/qwen3-14b
#   ollama/qwen2.5-coder:7b
#   openai/gpt-4o
# BT_AGENT_MODEL=lm_studio/qwen/qwen3-14b

# ─── LM Studio ───────────────────────────────────────────────────────────────
# Base URL of the LM Studio local server (must include /v1).
# Required when using any lm_studio/ model.
# LM_STUDIO_API_BASE=http://127.0.0.1:1234/v1

# LM Studio does not use authentication, but this can be set if a reverse
# proxy in front of LM Studio requires a key. Leave unset otherwise.
# LM_STUDIO_API_KEY=
